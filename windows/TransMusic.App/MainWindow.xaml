<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TransMusic.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:TransMusic.Core"
    xmlns:conv="using:TransMusic.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:StatusBrushConverter x:Key="StatusBrush" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:PathToImageConverter x:Key="CoverImage" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======== 0. 标题栏（可拖动） ======== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="46" Padding="16,0,150,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE8D6;" FontSize="15"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="音频格式转换器" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="TransMusic" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{Binding EngineVersion}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- ======== 1. 工具栏 ======== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="16,2,16,10">
            <Button Content="＋ 添加文件" Click="OnAddFiles" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="添加文件夹" Click="OnAddFolder" />
            <Button Content="移除所选" Click="OnRemoveSelected" />
            <Button Content="清空" Click="OnClear" />
            <Button Content="日志" Click="OnToggleLog" />
            <TextBlock Text="支持拖拽文件 / 文件夹 · 可拖入视频只取音轨 · 双击查看详情"
                       VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- ======== 2. 主体 ======== -->
        <Grid Grid.Row="2" Padding="16,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="336" />
            </Grid.ColumnDefinitions>

            <!-- 任务列表 -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="JobList" Grid.Row="0" SelectionMode="Extended"
                              ItemsSource="{Binding Jobs}"
                              Padding="0,4,0,4" DoubleTapped="OnJobDoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 曲目封面缩略图（无封面时显示音符占位） -->
                                    <Border Width="44" Height="44" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <Image Source="{Binding CoverPath, Converter={StaticResource CoverImage}}"
                                                   Stretch="UniformToFill" />
                                            <TextBlock Text="♪" FontSize="18" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasCoverImage, Converter={StaticResource InverseBoolToVisibility}}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1" RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding MetaText}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <Grid Grid.Row="2" ColumnSpacing="8"
                                          Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="3" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="EmptyHint" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" LineHeight="22"
                               Text="把音频或视频拖到这里&#x0a;MP3 · FLAC · WAV · AAC · ALAC · OGG · Opus · WMA · AIFF · WV · TTA · AC3"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <Border Grid.Row="1" Padding="12,6" BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="6"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧设置 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Spacing="10">

                    <Border CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="输出" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Summary}" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{Binding OutputSummary}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                    </Border>

                    <ComboBox x:Name="ThemeBox" Header="外观" HorizontalAlignment="Stretch"
                              SelectedIndex="{Binding ThemeModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>

                    <ComboBox x:Name="FormatBox" Header="目标格式" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Formats}" DisplayMemberPath="Display"
                              SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" />

                    <ComboBox x:Name="QualityBox" Header="质量" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding QualityItems}" DisplayMemberPath="Label"
                              SelectedIndex="{Binding QualityIndex, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="SampleRateBox" Header="采样率" Width="150"
                                  ItemsSource="{Binding SampleRateLabels}"
                                  SelectedIndex="{Binding SampleRateIndex, Mode=TwoWay}" />
                        <ComboBox x:Name="ChannelBox" Header="声道" Width="140"
                                  ItemsSource="{Binding ChannelLabels}"
                                  SelectedIndex="{Binding ChannelIndex, Mode=TwoWay}" />
                    </StackPanel>

                    <NumberBox x:Name="CompBox" Header="压缩级别" HorizontalAlignment="Stretch"
                               Minimum="0" Maximum="12" SmallChange="1" SpinButtonPlacementMode="Compact"
                               Value="{Binding CompLevel, Mode=TwoWay}"
                               Visibility="{Binding CompVisible, Converter={StaticResource BoolToVisibility}}" />

                    <ComboBox x:Name="PresetBox" Header="常用预设" HorizontalAlignment="Stretch"
                              PlaceholderText="选择后立即套用"
                              ItemsSource="{Binding Presets}" DisplayMemberPath="Label"
                              SelectionChanged="OnPresetChanged" />

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4" />

                    <CheckBox Content="输出到源文件所在文件夹" IsChecked="{Binding SameAsSource, Mode=TwoWay}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="输出文件夹" PlaceholderText="选择文件夹…"
                                 Text="{Binding OutputDir, Mode=TwoWay}"
                                 IsEnabled="{Binding SameAsSource, Converter={StaticResource InverseBool}}" />
                        <Button Grid.Column="1" Content="浏览" Click="OnBrowseOutput" VerticalAlignment="Bottom" />
                    </Grid>

                    <TextBox Header="文件名模板" PlaceholderText="{}{name}"
                             Text="{Binding Template, Mode=TwoWay}" />
                    <TextBlock Text="{}{name} 原名 · {artist} 艺人 · {title} 标题 · {index} 序号"
                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <ComboBox x:Name="ConflictBox" Header="重名处理" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="自动重命名 (1)" />
                        <ComboBoxItem Content="直接覆盖" />
                        <ComboBoxItem Content="跳过该文件" />
                    </ComboBox>

                    <NumberBox Header="并发任务数" Minimum="1" Maximum="16" SmallChange="1"
                               SpinButtonPlacementMode="Compact"
                               Value="{Binding Workers, Mode=TwoWay}" />

                    <CheckBox Content="保留标签与元数据" IsChecked="{Binding KeepMetadata, Mode=TwoWay}" />
                    <CheckBox Content="复制内嵌封面" IsChecked="{Binding KeepCover, Mode=TwoWay}" />

                    <TextBox x:Name="LogBox" Header="日志" Height="150" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                             Text="{Binding LogText}"
                             Visibility="{Binding LogVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ======== 3. 操作栏 ======== -->
        <Grid Grid.Row="3" Padding="16,10,16,14" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Content="开始转换" Click="OnStart"
                    Style="{StaticResource AccentButtonStyle}" MinWidth="150" Height="36" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="OnCancel"
                    IsEnabled="False" Height="36" />
            <TextBlock x:Name="TipText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="参数会记住上次的选择 · 取消会立即终止 ffmpeg 并删除半成品" />
        </Grid>
    </Grid>
</Window>
